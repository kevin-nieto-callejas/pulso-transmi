# --- API del reto -----------------------------------------------------------
PULSO_API_URL=https://pulso-transmi.72-60-245-2.sslip.io

# Identidad del participante, necesaria para enviar predicciones. Se genera
# uno mismo en el portal (https://pulso-transmi.72-60-245-2.sslip.io/) con el
# correo institucional y el documento; tiene el formato ptm_live_...
# Si falta, src/infer.py arma y valida el batch pero NO lo envia.
# En GitHub Actions vive como secret, nunca en el repositorio.
PULSO_API_KEY=

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=

# Lectura publica (RLS activo, solo permite SELECT): la anon/publishable key.
# Es la unica que puede aparecer en el navegador; la usa el dashboard.
SUPABASE_KEY=

# Escrituras (collector, migraciones, entrenamiento, GitHub Actions): requiere
# la service_role key (Supabase Dashboard > Settings > API > service_role).
# Nunca exponerla en el navegador ni en Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# --- Opcionales -------------------------------------------------------------
# Minutos que cada corrida de inferencia se queda vigilando si se abre un
# ciclo. GitHub descarta corridas programadas bajo carga, asi que el workflow
# usa 8; en local, 0 (una sola pasada) suele bastar.
# PULSO_POLL_MINUTES=8
# PULSO_POLL_INTERVAL_SECONDS=120

# Donde guarda MLflow el historial de experimentos. Por defecto va a una
# carpeta local del usuario, no al repositorio: SQLite no puede tomar bloqueos
# sobre rutas de red.
# MLFLOW_TRACKING_URI=sqlite:///C:/Users/<usuario>/AppData/Local/pulso-transmi/mlflow.db
